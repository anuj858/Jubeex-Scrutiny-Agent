      {
        "name": "Index",
        "description": "Index of the paper book listing document names and page numbers. This part appears once, near the front (usually after the Cover Page). Do not label a later similar contents list as Index; that later list is a different document."
      },
      {
        "name": "Office Report on Limitation",
        "description": "Page titled OFFICE REPORT ON LIMITATION (O/R on Limitation), including when the SLP caption and parties appear above that heading. Contains statements whether the petition is within time and delay in filing or re-filing. Not the Index line that merely names O/R on Limitation."
      },
      {
        "name": "Listing Proforma",
        "description": "Listing Proforma or Proforma for First Listing (Proforma for First Listing) with numbered columns."
      },
      {
        "name": "Synopsis",
        "description": "Synopsis of the case."
      },
      {
        "name": "List of Dates & Events",
        "description": "List of Dates and Events."
      },
      {
        "name": "Petition",
        "description": "Main Special Leave Petition or writ/arbitration petition body (Form 28), grounds, questions of law, and prayers. Not Vakalatnama, Memo of Appearance, or Office Report on Limitation."
      },
      {
        "name": "Affidavit",
        "description": "Supporting affidavit of the petitioner, usually headed AFFIDAVIT."
      },
      {
        "name": "Annexures",
        "description": "Annexures marked P1, P2,P3,P4,P5 or P-1, P-2, P-3, P-4, P-5 etc."
      },
      {
        "name": "Appendix",
        "description": "Appendix to the petition."
      },
      {
        "name": "Memo of Parties",
        "description": "Memo of Parties listing petitioner and respondent names and addresses. Not Memo of Appearance."
      },
      {
        "name": "Memo of Appearance",
        "description": "Letter titled MEMO OF APPEARANCE addressed To the Registrar, Supreme Court of India, asking to enter appearance on behalf of a party, signed by the advocate. Distinct from Memo of Parties and from Vakalatnama."
      },
      {
        "name": "Impugned Order",
        "description": "Copy of the High Court or other court judgment or order under challenge."
      },
      {
        "name": "Vakalatnama",
        "description": "Page titled VAKALATNAMA (V/A) appointing an advocate, with execution date and signatures. Not Memo of Appearance and not a Power of Attorney or Board Resolution."
      },
      {
        "name": "PoA/BR",
        "description": "Power of Attorney or Board Resolution authorising the signatory. Distinct from the Vakalatnama."
      },
      {
        "name": "Court Fees",
        "description": "Court fee stamps or court fee endorsement pages."
      }
    ],
    "splitting_strategy": {
      "allow_uncategorized": "include"
    }
  },
