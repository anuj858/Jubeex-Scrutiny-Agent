{
  "classify": {
    "product_type": "classify_v2",
    "configuration_id": null,
    "rules": [
      {
        "type": "SLP_CIVIL",
        "description": "Special Leave Petition (Civil) is filed against any judgment, decree, determination, sentence or order in any cause or matter passed or made by any court or tribunal in the territory of India."
      },
      {
        "type": "SLP_CRIMINAL",
        "description": "Special Leave Petition (Criminal) is filed against any judgment, decree, determination, sentence or order in a criminal proceeding passed or made by any court or tribunal in the territory of India."
      },
      {
        "type": "ARBITRATION_PETITION",
        "description": "Arbitration Petition typically involves matters related to appointment of arbitrators or challenging arbitral awards."
      },
      {
        "type": "WRIT_PETITION_CIVIL",
        "description": "Writ Petition (Civil) filed under Article 32 or 226 of the Constitution of India for enforcement of fundamental rights or other civil rights."
      },
      {
        "type": "WRIT_PETITION_CRIMINAL",
        "description": "Writ Petition (Criminal) filed under Article 32 or 226 for enforcement of fundamental rights involving personal liberty or criminal matters."
      },
      {
        "type": "other",
        "description": "Any other petition type not covered above."
      }
    ],
    "mode": "FAST",
    "parsing_configuration": {
      "max_pages": 6
    }
  },
  "extract-jubeex": {
    "product_type": "extract_v2",
    "configuration_id": null,
    "data_schema": {
      "$defs": {
        "AdvocateOnRecord": {
          "description": "AOR identity. Fill from Vakalatnama then AOR's Declaration.",
          "properties": {
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "AOR name",
              "title": "Name"
            },
            "registration_number": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "AOR code / registration number. Extract verbatim.",
              "title": "Registration Number"
            },
            "email": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "AOR email ONLY if printed",
              "title": "Email"
            },
            "mobile": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "AOR mobile ONLY if printed",
              "title": "Mobile"
            },
            "firm": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Firm name, if any",
              "title": "Firm"
            },
            "office_address": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Office address as printed",
              "title": "Office Address"
            },
            "source_part": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Vakalatnama or AOR's Declaration",
              "title": "Source Part"
            },
            "raw_text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Verbatim AOR block as printed, including name, address, email, and contact.",
              "title": "Raw Text"
            },
            "source_pages": {
              "description": "Global page numbers containing this data",
              "items": {
                "type": "integer"
              },
              "title": "Source Pages",
              "type": "array"
            },
            "confidence": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Extractor confidence as a percentage string such as 95% or 65%. Do not use a 0-1 decimal.",
              "title": "Confidence"
            }
          },
          "title": "AdvocateOnRecord",
          "type": "object"
        },
        "CauseTitle": {
          "description": "The 'X versus Y' heading of the case. Extracted as printed.",
          "properties": {
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Short cause title as commonly cited, e.g. 'Meera Krishnan v. Union of India & Anr.'",
              "title": "Title"
            },
            "formatted_title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Cause title built from Cover Page main names and party counts. Each side is 'MainName' if that side has 1 party, 'MainName and Anr.' if that side has exactly 2 parties, 'MainName and Ors.' if that side has 3 or more. Join sides with ' VS '. Example: two petitioners and four respondents → 'Meera Krishnan and Anr. VS Union of India and Ors.' Main names come from the Cover Page. Do not invent extra parties.",
              "title": "Formatted Title"
            },
            "raw_text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The cause title verbatim, including '...and others' / '...and another'",
              "title": "Raw Text"
            },
            "main_petitioner": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Main petitioner name as printed on the Cover Page cause-title line.",
              "title": "Main Petitioner"
            },
            "main_respondent": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Main respondent name as printed on the Cover Page cause-title line.",
              "title": "Main Respondent"
            },
            "source_part": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Split label where the stored title was filled (Memo of Parties or Cover Page).",
              "title": "Source Part"
            },
            "source_pages": {
              "description": "Global page numbers containing this data",
              "items": {
                "type": "integer"
              },
              "title": "Source Pages",
              "type": "array"
            },
            "confidence": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Extractor confidence as a percentage string such as 95% or 65%. Do not use a 0-1 decimal.",
              "title": "Confidence"
            }
          },
          "title": "CauseTitle",
          "type": "object"
        },
        "ImpugnedOrder": {
          "description": "The order under challenge. Primary Impugned Order slot only.",
          "properties": {
            "is_primary": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": true,
              "description": "True for the Impugned Order slot. Do not invent extra annexure orders.",
              "title": "Is Primary"
            },
            "case_number": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Case number before the earlier court",
              "title": "Case Number"
            },
            "order_date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Date of the order under challenge",
              "title": "Order Date"
            },
            "Forum": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The court/forum that passed the impugned order",
              "title": "Forum"
            },
            "bench": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Bench or seat as printed",
              "title": "Bench"
            },
            "certified_copy_applied_on": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Date the certified copy was applied for",
              "title": "Certified Copy Applied On"
            },
            "certified_copy_obtained_on": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Date it was obtained",
              "title": "Certified Copy Obtained On"
            },
            "raw_text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Verbatim impugned-order identification as printed.",
              "title": "Raw Text"
            },
            "source_part": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Impugned Order",
              "title": "Source Part"
            },
            "source_pages": {
              "description": "Global page numbers containing this data",
              "items": {
                "type": "integer"
              },
              "title": "Source Pages",
              "type": "array"
            },
            "confidence": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Extractor confidence as a percentage string such as 95% or 65%. Do not use a 0-1 decimal.",
              "title": "Confidence"
            }
          },
          "title": "ImpugnedOrder",
          "type": "object"
        },
        "Inconsistencies": {
          "properties": {
            "items": {
              "description": "Spelling or value mismatches between fill and verify sources. Also record an ORGANIZATION party with no acting_through.",
              "items": {
                "$ref": "#/$defs/InconsistencyItem"
              },
              "title": "Items",
              "type": "array"
            },
            "source_part": {
              "description": "Split labels involved in the mismatches.",
              "items": {
                "type": "string"
              },
              "title": "Source Part",
              "type": "array"
            },
            "source_pages": {
              "description": "Global page numbers involved in the mismatches.",
              "items": {
                "type": "integer"
              },
              "title": "Source Pages",
              "type": "array"
            },
            "confidence": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Extractor confidence as a percentage string such as 95% or 65%. Do not use a 0-1 decimal.",
              "title": "Confidence"
            }
          },
          "title": "Inconsistencies",
          "type": "object"
        },
        "InconsistencyItem": {
          "properties": {
            "id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Sequential id as a string, starting at 1.",
              "title": "Id"
            },
            "label": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Short mismatch label",
              "title": "Label"
            },
            "raw_text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "What differed, quoting both sources.",
              "title": "Raw Text"
            }
          },
          "title": "InconsistencyItem",
          "type": "object"
        },
        "Party": {
          "description": "One petitioner or respondent. Fill from Memo of Parties then Main Petition page 1.",
          "properties": {
            "serial": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Position in the cause title, 1-based",
              "title": "Serial"
            },
            "kind": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "INDIVIDUAL or ORGANIZATION from the printed name on the Main Petition (and Memo of Parties). ORGANIZATION if the name has a prefix M/s, M/s., Messrs, The, Union, Government of, Ministry of, Department of, or a suffix Pvt Ltd, Pvt. Ltd., Private Limited, Ltd, Limited, LLP, LLC, Inc., Corp., Corporation, Co., Company, Foundation, Trust, Society, Association. Treat 'The' as a name prefix (The State of …), not every word 'the'. Always uppercase. Leave null if unclear.",
              "title": "Kind"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Full name as printed. Do not concatenate S/o or W/o into the name.",
              "title": "Name"
            },
            "entity_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Short type label from the printed name, e.g. INDIVIDUAL, Union, Company. Not limited to a fixed enum. Leave null if not printed.",
              "title": "Entity Type"
            },
            "acting_through": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Person named after 'acting through' / 'through' under the party block. May appear under an organization or an individual. ORGANIZATION almost always has this; if missing, leave null and add an inconsistencies item. INDIVIDUAL: fill only when those words appear.",
              "title": "Acting Through"
            },
            "relation": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Relation prefix only, e.g. S/o, D/o, W/o. Leave null if not printed.",
              "title": "Relation"
            },
            "guardian": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Related person's name after S/o, D/o, W/o. Leave null if not printed.",
              "title": "Guardian"
            },
            "occupation": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Occupation ONLY if explicitly stated.",
              "title": "Occupation"
            },
            "address": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Verbatim address. Leave null if not printed on a fill source. Never copy from Vakalatnama.",
              "title": "Address"
            },
            "city": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Extracted city",
              "title": "City"
            },
            "state": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Extracted state",
              "title": "State"
            },
            "pin_code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Extracted pincode",
              "title": "Pin Code"
            },
            "email": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Email ONLY if explicitly printed. Do not invent.",
              "title": "Email"
            },
            "mobile": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Mobile ONLY if explicitly printed. Do not invent.",
              "title": "Mobile"
            },
            "is_primary": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "True for the party whose name matches the Cover Page main petitioner or main respondent. False for the others. Do not invent a party from Cover Page.",
              "title": "Is Primary"
            },
            "raw_text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Verbatim party block as printed, including name, relation, and address lines.",
              "title": "Raw Text"
            },
            "source_part": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Must be Memo of Parties or Main Petition. Never Vakalatnama or Cover Page.",
              "title": "Source Part"
            },
            "source_pages": {
              "description": "Global page numbers containing this data",
              "items": {
                "type": "integer"
              },
              "title": "Source Pages",
              "type": "array"
            },
            "confidence": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Extractor confidence as a percentage string such as 95% or 65%. Do not use a 0-1 decimal.",
              "title": "Confidence"
            }
          },
          "title": "Party",
          "type": "object"
        }
      },
      "description": "Fields LlamaExtract fills from the extract pack.",
      "properties": {
        "court": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Court where the petition is filed, as a string. Fill from Cover Page; check spelling on Main Petition, Vakalatnama, Office Report on Limitation, Affidavit, and Memo of Parties.",
          "title": "Court"
        },
        "petition_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Petition type as printed, e.g. Special Leave Petition (Civil). Fill from Cover Page; check spelling on Main Petition, Vakalatnama, Office Report on Limitation, Affidavit, and Memo of Parties.",
          "title": "Petition Type"
        },
        "cause_title": {
          "anyOf": [
            {
              "$ref": "#/$defs/CauseTitle"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cause title representing petitioner vs respondent."
        },
        "petitioners": {
          "description": "Petitioners. One record per petitioner.",
          "items": {
            "$ref": "#/$defs/Party"
          },
          "title": "Petitioners",
          "type": "array"
        },
        "respondents": {
          "description": "Respondents. One record per respondent.",
          "items": {
            "$ref": "#/$defs/Party"
          },
          "title": "Respondents",
          "type": "array"
        },
        "advocates_on_record": {
          "description": "Advocates-on-Record.",
          "items": {
            "$ref": "#/$defs/AdvocateOnRecord"
          },
          "title": "Advocates On Record",
          "type": "array"
        },
        "impugned_orders": {
          "description": "Primary impugned order only.",
          "items": {
            "$ref": "#/$defs/ImpugnedOrder"
          },
          "title": "Impugned Orders",
          "type": "array"
        },
        "relief_sort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Main prayer body only from the Main Petition last 2-3 pages. Copy the text under the heading Main Prayer or Prayer. Do not include the heading, clause number, markdown, or HTML (for example omit '7. MAIN PRAYER:' and '<u>**MAIN PRAYER**</u>:'). Start at the prayer sentence, e.g. 'In the circumstances stated above…'. Leave null if that heading is not printed.",
          "title": "Relief Sort"
        },
        "inconsistencies": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inconsistencies"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spelling mismatches between fill and verify sources, plus an ORGANIZATION party with no acting_through. items[].id is '1', '2', …; items[].raw_text quotes both sources."
        }
      },
      "title": "LegalExtractRecord",
      "type": "object"
    },
    "tier": "agentic",
    "extraction_target": "per_doc",
    "system_prompt": null,
    "cite_sources": true,
    "confidence_scores": true
  },
  "parse": {
    "product_type": "parse_v2",
    "configuration_id": null,
    "tier": "agentic",
    "version": "latest"
  },
  "split": {
    "product_type": "split_v1",
    "configuration_id": null,
    "categories": [
      {
        "name": "Advocate's Checklist",
        "description": "Advocate's Check List or Proposed Advocate's Check List, usually a numbered YES/NO/N.A. list certified by the Advocate-on-Record."
      },
      {
        "name": "Caveat Report",
        "description": "Caveat or Caveat Report filed in the Supreme Court."
      },
      {
        "name": "Cover Page",
        "description": "Outer cover or title sheet of the paper book. Do not use this for Office Report on Limitation, Vakalatnama, or Memo of Appearance even if the SLP caption is repeated at the top."
      },
      {
        "name": "Record of Proceedings",
        "description": "Record of Proceedings or court order sheets of this Court."
      },
      {
        "name": "AOR's Declaration",
        "description": "Advocate-on-Record declaration or certificate, other than the Advocate's Check List."
      },
      {
        "name": "Index",
        "description": "Index of the paper book listing document names and page numbers. This part appears once, near the front (usually after the Cover Page). Do not label a later similar contents list as Index; that later list is a different document."
      },
      {
        "name": "Office Report on Limitation",
        "description": "Page titled OFFICE REPORT ON LIMITATION (O/R on Limitation), including when the SLP caption and parties appear above that heading. Contains statements whether the petition is within time and delay in filing or re-filing. Not the Index line that merely names O/R on Limitation."
      },
      {
        "name": "Listing Proforma",
        "description": "Listing Proforma or Proforma for First Listing (Proforma for First Listing) with numbered columns."
      },
      {
        "name": "Synopsis",
        "description": "Synopsis of the case."
      },
      {
        "name": "List of Dates & Events",
        "description": "List of Dates and Events."
      },
      {
        "name": "Main Petition",
        "description": "Main Petition body (Form 28): Special Leave Petition or writ/arbitration petition, grounds, questions of law, and prayers. Not Vakalatnama, Memo of Appearance, or Office Report on Limitation."
      },
      {
        "name": "Affidavit",
        "description": "Supporting affidavit of the petitioner, usually headed AFFIDAVIT."
      },
      {
        "name": "Annexures",
        "description": "Annexures marked P1, P2,P3,P4,P5 or P-1, P-2, P-3, P-4, P-5 etc."
      },
      {
        "name": "Appendix",
        "description": "Appendix to the petition."
      },
      {
        "name": "Memo of Parties",
        "description": "Memo of Parties listing petitioner and respondent names and addresses. Not Memo of Appearance."
      },
      {
