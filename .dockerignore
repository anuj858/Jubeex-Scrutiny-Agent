# Deny the entire context by default. Keep this allowlist aligned with
# Dockerfile.worker's runtime inputs and pyproject.toml's Hatch package data.
**
!README.md
!pyproject.toml
!uv.lock
!scripts/
!scripts/start.sh
!configs/
!configs/config.json
!src/
!src/extraction_review/
!src/extraction_review/**
!scrutiny_harness/
!scrutiny_harness/rules/
!scrutiny_harness/rules/**
!ui/
!ui/package.json
!ui/package-lock.json
!ui/index.html
!ui/components.json
!ui/postcss.config.mjs
!ui/tsconfig.json
!ui/vite.config.ts
!ui/src/
!ui/src/**

# Defense in depth: never re-include credentials, local state, or build/test
# artifacts, even if the allowlist is broadened later.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/*.cer
**/*.p8
**/*.der
**/*.jks
**/*.keystore
**/*credentials*.json
**/*secret*.json
**/.aws/**
**/.ssh/**
**/.config/gcloud/**
**/.venv/**
**/venv/**
**/.tox/**
**/__pycache__/**
**/.pytest_cache/**
**/.ruff_cache/**
**/.mypy_cache/**
**/htmlcov/**
**/build/**
**/dist/**
**/.coverage*
**/node_modules/**
**/tmp/**
**/temp/**
**/artifacts/**
**/qa_reports/**
**/logs/**
**/tests/**
**/evaluation/**
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
