{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jubeex.local/schemas/sci_registry_defects.schema.v1.json",
  "title": "Jubeex registry defect catalogue (API payload shape)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogue_id",
    "schema_version",
    "catalogue_version",
    "jurisdiction",
    "defects"
  ],
  "properties": {
    "catalogue_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "catalogue_version": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "disclaimer": {
      "type": ["string", "null"]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "defects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/defect"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "authority_type"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 2,
          "description": "Stable id, e.g. SCI_CHECKLIST_2025, SCI_FORM_28, SCI_RULES_2013"
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "authority_type": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": ["string", "null"]
        },
        "alternate_urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other URLs for the same document (e.g. the Defect List Drive copy of SCI_CHECKLIST_2025)"
        },
        "issued_date": {
          "type": ["string", "null"]
        },
        "effective_date": {
          "type": ["string", "null"]
        },
        "checksum": {
          "type": ["string", "null"]
        },
        "locators": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "prompt"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "description": "Stable id, e.g. filing_formalities"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "description": "Shown in the system prompt, e.g. Filing Formalities"
        },
        "prompt": {
          "type": "string",
          "minLength": 20,
          "description": "Category-level context. One per area, reused by every defect in that area."
        }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "serial_no",
        "main_category",
        "defect",
        "requirement",
        "where_to_look",
        "how_to_cure",
        "location_source"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^D\\d{3,4}$",
          "description": "Internal check id, e.g. D001. API serial_no is the registry S.No."
        },
        "serial_no": {
          "type": "integer",
          "minimum": 1,
          "description": "S.No. from the defect API / registry list"
        },
        "main_category": {
          "type": "string",
          "minLength": 2,
          "description": "Main Category, e.g. SLP (Civil)"
        },
        "special_category": {
          "type": ["string", "null"]
        },
        "category_id": {
          "type": ["string", "null"],
          "description": "Links this defect to a categories[].id prompt"
        },
        "parent_check_id": {
          "type": ["string", "null"],
          "pattern": "^D\\d{3,4}$",
          "description": "If this is a narrower slice of another catalogue defect"
        },
        "overlap_note": {
          "type": ["string", "null"],
          "description": "How this check differs from the parent; injected into the defect prompt"
        },
        "defect": {
          "type": "string",
          "minLength": 10,
          "description": "Defect/Objection text"
        },
        "requirement": {
          "type": "string",
          "minLength": 10,
          "description": "Requirement (Basis)"
        },
        "trigger_words": {
          "type": ["string", "null"],
          "description": "Trigger Words used to locate the required statement"
        },
        "where_to_look": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          },
          "description": "Where to Look steps (human/LLM instructions). Not the retrieval source of truth."
        },
        "inspect_parts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "description": "LlamaSplit document_part labels that must be retrieved before defect_found is allowed. Use configs/config.json split.categories names."
        },
        "context_parts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "description": "Extra Split labels to retrieve for comparison/context. Missing these does not force needs_review."
        },
        "exclude_parts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "description": "Split labels that must not be used as evidence (e.g. Index listing lines). Defaults to Index when omitted on non-index checks."
        },
        "how_to_cure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          },
          "description": "How to cure steps"
        },
        "applicable_rule": {
          "type": ["string", "null"],
          "description": "Applicable Rule/Clause. Null when the source row has none."
        },
        "location_source": {
          "type": "string",
          "minLength": 5,
          "description": "Location/Source"
        }
      }
    }
  }
}
