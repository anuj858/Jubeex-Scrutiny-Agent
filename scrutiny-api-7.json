{
  "family": "jubeex-scrutiny-api",
  "taskRoleArn": "arn:aws:iam::893338224943:role/jubeexScrutinyTaskRole",
  "executionRoleArn": "arn:aws:iam::893338224943:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "jubeex-scrutiny-api",
      "image": "893338224943.dkr.ecr.ap-south-1.amazonaws.com/jubeex-scrutiny-agent:fastapi-v4",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "VECTOR_BACKEND",
          "value": "pinecone"
        },
        {
          "name": "SCRUTINY_MAX_CHUNKS",
          "value": "12"
        },
        {
          "name": "PINECONE_CLOUD",
          "value": "aws"
        },
        {
          "name": "OPENROUTER_TIMEOUT_S",
          "value": "180"
        },
        {
          "name": "OPENROUTER_APP_TITLE",
          "value": "JubeeX Scrutiny"
        },
        {
          "name": "SCRUTINY_ENABLED",
          "value": "true"
        },
        {
          "name": "PINECONE_INDEX",
          "value": "legal-document-knowledge"
        },
        {
          "name": "SCRUTINY_DEFECTS",
          "value": "all"
        },
        {
          "name": "PINECONE_REGION",
          "value": "us-east-1"
        },
        {
          "name": "PINECONE_EMBED_MODEL",
          "value": "llama-text-embed-v2"
        },
        {
          "name": "PINECONE_NAMESPACE",
          "value": "jubeex-filings"
        },
        {
          "name": "SCRUTINY_TOP_K",
          "value": "8"
        },
        {
          "name": "OPENROUTER_MODEL",
          "value": "google/gemini-3.8-flash"
        },
        {
          "name": "OPENROUTER_BASE_URL",
          "value": "https://openrouter.ai/api/v1"
        },
        {
          "name": "SCRUTINY_CONCURRENCY",
          "value": "6"
        },
        {
          "name": "PINECONE_TEXT_FIELD",
          "value": "normalized_text"
        },
        {
          "name": "JUBEEX_SQS_INGESTION_QUEUE_URL",
          "value": "https://sqs.ap-south-1.amazonaws.com/893338224943/jubeex-ingestion-jobs"
        },
        {
          "name": "JUBEEX_SQS_SCRUTINY_QUEUE_URL",
          "value": "https://sqs.ap-south-1.amazonaws.com/893338224943/jubeex-scrutiny-jobs"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-south-1"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "LLAMA_CLOUD_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:893338224943:secret:jubeex/llamaindex/api-key-jhcG3b:LLAMA_CLOUD_API_KEY::"
        },
        {
          "name": "OPENROUTER_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:893338224943:secret:jubeex/scrutiny-agent-DFHpAn:OPENROUTER_API_KEY::"
        },
        {
          "name": "PINECONE_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:893338224943:secret:jubeex/scrutiny-agent-DFHpAn:PINECONE_API_KEY::"
        },
        {
          "name": "JUBEEX_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:893338224943:secret:jubeex/scrutiny-api-key-3zVFXj:JUBEEX_API_KEY::"
        },
        {
          "name": "JUBEEX_CALLBACK_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:893338224943:secret:jubeex/scrutiny-agent-DFHpAn:JUBEEX_CALLBACK_URL::"
        },
        {
          "name": "JUBEEX_CALLBACK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:893338224943:secret:jubeex/scrutiny-agent-DFHpAn:JUBEEX_CALLBACK_SECRET::"
        },
        {
          "name": "JUBEEX_SQS_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:893338224943:secret:jubeex/scrutiny-agent-DFHpAn:JUBEEX_SQS_ENABLED::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jubeex-scrutiny-agent",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ai-api"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/v1/health')\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "systemControls": []
    }
  ],
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}