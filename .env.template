# Copy to .env and add secrets. Optional values below are already pre-filled in
# pyproject.toml [tool.llamadeploy.env]; keep them here only to override.
# Note: LLAMA_CLOUD_API_KEY does not need to be added here. This template has
# `llama_cloud = true` set under [tool.llamadeploy] in pyproject.toml, so llamactl
# will prompt you to log in and automatically inject the API key into your process.
# OPENAI_API_KEY=sk-xxx

# API authentication fails closed unless this secret is configured. Set the
# unauthenticated override only for an isolated local developer process.
JUBEEX_API_KEY=
# JUBEEX_ALLOW_UNAUTHENTICATED=true

# Comma-separated HTTPS hosts allowed to serve caller-supplied filing PDFs.
# Include the application upload host and the workspace S3 virtual host.
JUBEEX_REMOTE_FILE_HOSTS=
JUBEEX_MAX_PDF_BYTES=52428800

# Optional project scoping
# LLAMA_DEPLOY_PROJECT_ID=
# LLAMA_CLOUD_BASE_URL=

# Split-upload UI always uploads sliced slot PDFs so Submit/Download work.
# Set this only for backends that consume slice JSON without LlamaCloud file ids.
# The Jubeex portal re-slices from S3, so the worker should skip these uploads.
# SKIP_SLOT_PDF_UPLOAD=true
# PARSE_CONCURRENCY=8
# INGEST_CONCURRENCY=8
# SLOT_UPLOAD_CONCURRENCY=8
# Secondary parts also use OCRia-1 by default. Set fast only to reduce cost.
# FAST_PARSE_TIER=agentic
# Split reconciliation: llama_only | targeted | legacy_full.
# targeted preserves correct Llama segments and applies only evidence-backed
# Python corrections. The old boolean remains supported as a compatibility
# fallback (true => targeted, false => llama_only).
SPLIT_RECONCILIATION_MODE=targeted
# Large compiled PDFs can exceed the LlamaCloud SDK's 60-second write timeout.
LLAMA_CLOUD_REQUEST_TIMEOUT_S=900
# Output filter: All, Annexures, or comma-separated canonical document names.
# Keep every classified document (and Unidentified pages) in the split result.
SPLIT_OUTPUT_DOCUMENTS=All
# Compatibility only; ignored while SPLIT_RECONCILIATION_MODE is valid.
SPLIT_PYTHON_RULES_ENABLED=false
# Used only when local rules are enabled (or by offline repair utilities).
# Keep at 2 for a 1-vCPU task; increase only with sufficient worker CPU.
SPLIT_OCR_CONCURRENCY=2

# Pinecone vector DB (integrated embeddings)
PINECONE_API_KEY=
PINECONE_INDEX=legal-document-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_TEXT_FIELD=normalized_text
PINECONE_NAMESPACE=jubeex-filings
# HTTP pool + in-process cap for concurrent Pinecone queries during scrutiny.
# Default urllib3 pool is 10; without these, SCRUTINY_CONCURRENCY × queries
# triggers "Connection pool is full, discarding connection" warnings.
PINECONE_POOL_THREADS=32
PINECONE_QUERY_CONCURRENCY=10
VECTOR_BACKEND=pinecone



# LLM: gemini (Developer API key), vertex (ADC/WIF), or openrouter
LLM_PROVIDER=openrouter
# Gemini Developer API (recommended for direct Gemini access). Create the key
# in Google AI Studio for a paid project; never commit the real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_REQUESTS_PER_MINUTE=8
# GEMINI_SHARED_RATE_LIMIT=true
GEMINI_MAX_ATTEMPTS=4
GEMINI_REQUEST_TIMEOUT_S=900
GOOGLE_CLOUD_PROJECT=scrutiny-jubeex
GOOGLE_CLOUD_LOCATION=global
# Local: gcloud auth application-default login
# ECS: GOOGLE_APPLICATION_CREDENTIALS=/app/google-wif-credentials.json
VERTEX_MODEL=gemini-4-argon

VISION_ENABLED=true
VISION_PROVIDER=openrouter
VISION_MODEL=gemini-4-argon
# Backward-compatible OpenRouter-specific aliases:
OPENROUTER_VISION_ENABLED=true
OPENROUTER_VISION_MODEL=google/gemini-4-argon
# OPENROUTER_VISION_FALLBACK_MODEL=openai/gpt-5.5
VISION_PREVIEW_DPI=160
VISION_CONCURRENCY=4
VISION_MAX_OUTPUT_TOKENS=4096

# OpenRouter (required for registry defect scrutiny)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.5
OPENROUTER_MODEL=google/gemini-4-argon
# Dedicated defect-checking model. Vertex accepts the unprefixed value;
# OpenRouter accepts the google/ prefix. The runtime normalizes either form.
SCRUTINY_MODEL=google/gemini-4-argon
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=180
OPENROUTER_MAX_ATTEMPTS=4
VISION_REQUEST_TIMEOUT_S=120
# Provider-specific rolling-minute limits (0 = unlimited). The Vertex limit is
# shared through the artifact S3 bucket when SQS workers are enabled, so ECS
# autoscaling cannot multiply the project-wide request rate.
OPENROUTER_REQUESTS_PER_MINUTE=25
VERTEX_REQUESTS_PER_MINUTE=8
# VERTEX_SHARED_RATE_LIMIT=true
VERTEX_MAX_ATTEMPTS=6
VERTEX_REQUEST_TIMEOUT_S=900
# LLM_REQUESTS_PER_MINUTE=0

# Registry defect scrutiny. Use db (default) or json (bundled rules file).
SCRUTINY_CATALOGUE_SOURCE=json
# postgresql://jubeex_parse_ro:PASSWORD@HOST:5432/DATABASE
CATALOGUE_DATABASE_URL=
# SCRUTINY_DEFECTS is an allowlist of catalogue check ids (D-1, D-10, ...), or "all".
# Empty or "all" runs every enabled production defect. A list narrows that set.
SCRUTINY_ENABLED=true
SCRUTINY_DEFECTS=all
# For a controlled test only, override with an explicit allowlist, e.g.
# SCRUTINY_DEFECTS=D-1,D-57,D-58,D-64,D-68,D-69,D-112,D-161,D-179,D-226,D-327
SCRUTINY_CONCURRENCY=8
JUBEEX_WORKER_MAX_JOB_SECONDS=5400
# How often to write the growing report back to Agent Data (not every check)
# SCRUTINY_PERSIST_EVERY=10
# Retrieval only (scrutiny-check). Does not change how filings are indexed.
# Each concurrent check (SCRUTINY_CONCURRENCY) queries Pinecone for its own
# captions/headings — the whole filing is not dumped into every LLM call.
# TOP_K = neighbours Pinecone returns per query. MAX_CHUNKS = ceiling on
# excerpts sent to that check; each defect then applies a smaller budget.
# REVIEW_CONFIDENCE = below this, defect_found / compliant become needs_review.
SCRUTINY_TOP_K=8
SCRUTINY_MAX_CHUNKS=12
# Cross-encode the retrieved defect candidates before the evidence budget is applied.
SCRUTINY_RERANK_ENABLED=true
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
SCRUTINY_RERANK_MAX_CANDIDATES=60
PINECONE_RERANK_CONCURRENCY=4
SCRUTINY_REVIEW_CONFIDENCE=0.6

# Jubeex Backend webhook when an Agent job finishes
# Public Jubeex backend webhook (must include API port — usually :8000).
# Do NOT point this at the frontend host on :80 or callbacks return 404.
JUBEEX_CALLBACK_URL=http://3.111.86.61:8000/api/v1/webhooks/ai-agent
JUBEEX_CALLBACK_SECRET=

# Same bucket as filing PDFs. Step JSON lands at
# org/{org}/filing-workspace/{workspace}/{extractedfiles|splitfiles|defectfiles|layoutfiles|visualfiles}/{id}-v001-agent-{step}-{job}.json
AWS_S3_BUCKET=jubeex-893338224943-ap-south-1-an
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local batch QA client. QA_API_URL must be the Scrutiny Agent host whose
# /v1/health endpoint responds directly, not the full-application /api/v1 URL.
QA_API_URL=
QA_API_KEY=
QA_INPUT_BUCKET=
# Optional. Leave empty to classify each compiled PDF on the deployed service.
QA_FILING_TYPE=
QA_SPECIAL_CATEGORY=
# Used only when the batch command is run with --email (AWS SES).
QA_REPORT_FROM=
QA_REPORT_TO=anuj@jubeex.com

# SQS (Agent-owned). Same image in ECS runs `jubeex-sqs-worker` as a second service.
# Queues: jubeex-ingestion-jobs / jubeex-scrutiny-jobs
# DLQs:   jubeex-ingestion-jobs-dlq / jubeex-scrutiny-jobs-dlq (maxReceiveCount=3)
JUBEEX_SQS_ENABLED=true
JUBEEX_SQS_INGESTION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/893338224943/jubeex-ingestion-jobs
JUBEEX_SQS_SCRUTINY_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/893338224943/jubeex-scrutiny-jobs
JUBEEX_SQS_INGESTION_QUEUE_NAME=jubeex-ingestion-jobs
JUBEEX_SQS_SCRUTINY_QUEUE_NAME=jubeex-scrutiny-jobs
JUBEEX_SQS_VISIBILITY_TIMEOUT=3600
# Run separate ECS worker services for predictable latency under load:
# ingestion service: JUBEEX_WORKER_KINDS=process_file
# scrutiny service:  JUBEEX_WORKER_KINDS=scrutiny
# Leave empty only when one small deployment intentionally consumes both queues.
JUBEEX_WORKER_KINDS=
# Renews the message lease during long parse/scrutiny runs. Default is one-third
# of the visibility timeout, capped at 300 seconds.
JUBEEX_SQS_HEARTBEAT_SECONDS=300
