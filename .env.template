# Copy to .env and add secrets. Optional values below are already pre-filled in
# pyproject.toml [tool.llamadeploy.env]; keep them here only to override.
# Note: LLAMA_CLOUD_API_KEY does not need to be added here. This template has
# `llama_cloud = true` set under [tool.llamadeploy] in pyproject.toml, so llamactl
# will prompt you to log in and automatically inject the API key into your process.
# OPENAI_API_KEY=sk-xxx

# Optional project scoping
# LLAMA_DEPLOY_PROJECT_ID=
# LLAMA_CLOUD_BASE_URL=

# Pinecone vector DB (integrated embeddings)
PINECONE_API_KEY=
PINECONE_INDEX=legal-document-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_TEXT_FIELD=normalized_text
PINECONE_NAMESPACE=jubeex-filings
VECTOR_BACKEND=pinecone



# Cost-controlled private visual evidence analysis
# OPENROUTER_VISION_ENABLED=true
# OPENROUTER_VISION_MODEL=google/gemini-3.6-flash
# OPENROUTER_VISION_FALLBACK_MODEL=openai/gpt-5.5
# VISION_MAX_FALLBACK_PAGES_PER_PDF=12
# OPENROUTER_VISION_ZDR=true
# VISION_MAX_COST_USD_PER_PDF=1.50
# VISION_MONTHLY_BUDGET_USD=15.00
# VISION_REQUEST_RESERVE_USD=0.015
# VISION_FALLBACK_REQUEST_RESERVE_USD=0.05
# VISION_MAX_PAGE_REQUESTS_PER_PDF=60
# VISION_MAX_CROPS_PER_PAGE=4
# VISION_PREVIEW_DPI=120
# VISION_CROP_DPI=240
# VISION_MAX_OUTPUT_TOKENS=1800
# VISION_CONCURRENCY=6
# VISION_ACCEPTANCE_CONFIDENCE=0.75
# OCR_BATCH_CONCURRENCY=2
# PINECONE_UPSERT_CONCURRENCY=1
# PDF_PROCESS_WORKERS=4
# PROCESSING_CACHE_TTL_HOURS=24

# OpenRouter (required for registry defect scrutiny)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.5
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=180

# Registry defect scrutiny (scrutiny_harness/rules/sci_registry_defects.v1.json)
# SCRUTINY_DEFECTS is an allowlist of catalogue check ids (D025, D010, ...), or "all".
SCRUTINY_ENABLED=true
SCRUTINY_DEFECTS=D025,D010,D077,D078
SCRUTINY_CONCURRENCY=6
# Retrieval only (scrutiny-check). Does not change how filings are indexed.
# Each concurrent check (SCRUTINY_CONCURRENCY) queries Pinecone for its own
# captions/headings — the whole filing is not dumped into every LLM call.
# TOP_K = neighbours Pinecone returns per query. MAX_CHUNKS = ceiling on
# excerpts sent to that check; each defect then applies a smaller budget.
# REVIEW_CONFIDENCE = below this, defect_found / compliant become needs_review.
SCRUTINY_TOP_K=8
SCRUTINY_MAX_CHUNKS=12
# SCRUTINY_REVIEW_CONFIDENCE=0.6