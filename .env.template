# Copy to .env and add secrets. Optional values below are already pre-filled in
# pyproject.toml [tool.llamadeploy.env]; keep them here only to override.
# Note: LLAMA_CLOUD_API_KEY does not need to be added here. This template has
# `llama_cloud = true` set under [tool.llamadeploy] in pyproject.toml, so llamactl
# will prompt you to log in and automatically inject the API key into your process.
# OPENAI_API_KEY=sk-xxx

# Optional project scoping
# LLAMA_DEPLOY_PROJECT_ID=
# LLAMA_CLOUD_BASE_URL=

# Split-upload UI always uploads sliced slot PDFs so Submit/Download work.
# Set this only for backends that consume slice JSON without LlamaCloud file ids.
# The Jubeex portal re-slices from S3, so the worker should skip these uploads.
# SKIP_SLOT_PDF_UPLOAD=true
# PARSE_CONCURRENCY=8
# INGEST_CONCURRENCY=8
# SLOT_UPLOAD_CONCURRENCY=8
# FAST_PARSE_TIER=fast

# Pinecone vector DB (integrated embeddings)
PINECONE_API_KEY=
PINECONE_INDEX=legal-document-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_TEXT_FIELD=normalized_text
PINECONE_NAMESPACE=jubeex-filings
# HTTP pool + in-process cap for concurrent Pinecone queries during scrutiny.
# Default urllib3 pool is 10; without these, SCRUTINY_CONCURRENCY × queries
# triggers "Connection pool is full, discarding connection" warnings.
PINECONE_POOL_THREADS=32
PINECONE_QUERY_CONCURRENCY=10
VECTOR_BACKEND=pinecone



OPENROUTER_VISION_ENABLED=true
OPENROUTER_VISION_MODEL=google/gemini-3.8-flash
# OPENROUTER_VISION_FALLBACK_MODEL=openai/gpt-5.5
VISION_PREVIEW_DPI=160
VISION_CONCURRENCY=4
VISION_MAX_OUTPUT_TOKENS=4096

# OpenRouter (required for registry defect scrutiny)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.5
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=180
# Cap /chat/completions calls per rolling minute for this process (0 = unlimited).
# Match your OpenRouter key RPM — e.g. 20.
OPENROUTER_REQUESTS_PER_MINUTE=20

# Registry defect scrutiny.
# CATALOGUE_SOURCE=file reads scrutiny_harness/rules/sci_registry_defects.v1.json.
# CATALOGUE_SOURCE=db reads the shared Postgres views (v_parse_*) at the start of
# each job, and reloads only when hub_catalogue_state.revision changes.
# If that read fails, the job uses sci_registry_defects.v1.json instead.
# Leave CATALOGUE_SOURCE=file until DB-vs-file parity has passed.
CATALOGUE_SOURCE=file
# postgresql://jubeex_parse_ro:PASSWORD@HOST:5432/DATABASE
CATALOGUE_DATABASE_URL=
# SCRUTINY_DEFECTS is an allowlist of catalogue check ids (D-1, D-10, ...), or "all".
# In file mode an empty value runs nothing. In db mode an empty value or "all"
# runs every defect with is_enabled; a list narrows that set.
SCRUTINY_ENABLED=true
SCRUTINY_DEFECTS=D025,D010,D077,D078
SCRUTINY_CONCURRENCY=8
# How often to write the growing report back to Agent Data (not every check)
# SCRUTINY_PERSIST_EVERY=10
# Retrieval only (scrutiny-check). Does not change how filings are indexed.
# Each concurrent check (SCRUTINY_CONCURRENCY) queries Pinecone for its own
# captions/headings — the whole filing is not dumped into every LLM call.
# TOP_K = neighbours Pinecone returns per query. MAX_CHUNKS = ceiling on
# excerpts sent to that check; each defect then applies a smaller budget.
# REVIEW_CONFIDENCE = below this, defect_found / compliant become needs_review.
SCRUTINY_TOP_K=8
SCRUTINY_MAX_CHUNKS=12
# SCRUTINY_REVIEW_CONFIDENCE=0.6

# Jubeex Backend webhook when an Agent job finishes
# Public Jubeex backend webhook (must include API port — usually :8000).
# Do NOT point this at the frontend host on :80 or callbacks return 404.
JUBEEX_CALLBACK_URL=http://3.111.86.61:8000/api/v1/webhooks/ai-agent
JUBEEX_CALLBACK_SECRET=

# Same bucket as filing PDFs. Step JSON lands at
# org/{org}/filing-workspace/{workspace}/{extractedfiles|splitfiles|defectfiles|layoutfiles|visualfiles}/{id}-v001-agent-{step}-{job}.json
AWS_S3_BUCKET=jubeex-893338224943-ap-south-1-an
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SQS (Agent-owned). Same image in ECS runs `jubeex-sqs-worker` as a second service.
# Queues: jubeex-ingestion-jobs / jubeex-scrutiny-jobs
# DLQs:   jubeex-ingestion-jobs-dlq / jubeex-scrutiny-jobs-dlq (maxReceiveCount=3)
JUBEEX_SQS_ENABLED=true
JUBEEX_SQS_INGESTION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/893338224943/jubeex-ingestion-jobs
JUBEEX_SQS_SCRUTINY_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/893338224943/jubeex-scrutiny-jobs
JUBEEX_SQS_INGESTION_QUEUE_NAME=jubeex-ingestion-jobs
JUBEEX_SQS_SCRUTINY_QUEUE_NAME=jubeex-scrutiny-jobs
JUBEEX_SQS_VISIBILITY_TIMEOUT=3600