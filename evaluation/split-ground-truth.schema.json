{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jubeex.local/schemas/split-ground-truth.v1.json",
  "title": "Jubeex compiled split ground truth v1",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "jubeex.split-ground-truth.v1"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "source", "physical_page_count", "documents"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1, "description": "Stable pseudonymous non-sensitive case key."},
          "source": {
            "type": "object",
            "anyOf": [{"required": ["pdf_id"]}, {"required": ["sha256"]}],
            "properties": {
              "pdf_id": {"type": "string", "minLength": 1, "description": "Stable non-sensitive source PDF identifier."},
              "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
            },
            "additionalProperties": false
          },
          "physical_page_count": {"type": "integer", "minimum": 1},
          "input_quality": {"type": "string", "minLength": 1, "description": "Optional reviewed quality group, e.g. native_text, scanned, mixed, low_quality."},
          "documents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["document_id", "category", "start_page", "end_page"],
              "properties": {
                "document_id": {"type": "string", "minLength": 1},
                "category": {"type": "string", "minLength": 1, "description": "Exact canonical Split category or supported numbered Annexure/Application identity; validated against current product config."},
                "start_page": {"type": "integer", "minimum": 1},
                "end_page": {"type": "integer", "minimum": 1},
                "reviewer_notes": {"type": "string", "description": "Optional; keep out of reports and do not include personal data or petition text."},
                "ambiguity_flags": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
